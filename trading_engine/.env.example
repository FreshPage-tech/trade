APP_ENV=production
BROKER=robinhood
# Set true only when you intend to allow the selected broker to submit real orders.
LIVE_TRADING_ENABLED=True
DATABASE_PATH=./data/trading_engine.sqlite3

# USD engine exposure ceiling (Robinhood and Alpaca); validation cannot exceed $2,000.
CAPITAL_LIMIT_USD=2000
# Kite uses its separate INR limit below.
KITE_CAPITAL_LIMIT_INR=180000
PER_TRADE_RISK_FRACTION=0.005
MAX_OPEN_POSITIONS=5
MAX_DAILY_ENTRIES=3
MINIMUM_BACKTEST_TRADES=30
MINIMUM_BACKTEST_WIN_RATE=0.75
HISTORY_TTL_SECONDS=86400
REQUEST_RATE_PER_SECOND=1
REQUEST_BURST=2
POLL_INTERVAL_SECONDS=60
SCAN_INTERVAL_SECONDS=900

